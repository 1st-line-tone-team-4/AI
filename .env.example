AI_SERVER_API_KEY=
AI_LIVE_ENABLED=false
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=4096
# Copy/agreed mapping with the backend; empty means no model is enabled.
AI_MODEL_ALLOWLIST={}
AI_MODEL_ROUTES={}
AI_DEFAULT_MODEL_ID=
# Development runner only; HTTP provider requests require X-AI-Key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Opt-in only: verify the requested schema against the provider first.
GROQ_STRICT_OUTPUTS=false
AI_FREE_TIER_CONFIRMED=false
UPSTAGE_API_KEY=
UPSTAGE_DOCUMENT_MODEL=document-parse
UPSTAGE_TIMEOUT_SECONDS=120
DOCUMENT_CACHE_DIR=.cache/document-parse
